-table-ix-br-v2_3-27102026.pdf", "proto_unicast": true, "proto_multicast": false, "proto_ipv6": true, "website": "http://ix.br", "social_media": [{"service": "website", "identifier": "http://ix.br"}], "url_stats": "https://ix.br/trafego/agregado/rao", "tech_email": "noc@ix.br", "tech_phone": "+551155093550", "policy_email": "info@ix.br", "policy_phone": "+551155093550", "sales_phone": "+551155093550", "sales_email": "info@ix.br", "net_count": 15, "fac_count": 5, "ixf_net_count": 0, "ixf_last_import": null, "ixf_import_request": null, "ixf_import_request_status": "queued", "service_level": "Not Disclosed", "terms": "Not Disclosed", "status_dashboard": "https://status.ix.br/", "logo": "https://peeringdb-media-prod.s3.amazonaws.com/media/logos_user_supplied/internetexchange-4862-db4aab46.png", "created": "2025-10-24T14:04:26Z", "updated": "2026-10-28T13:58:30Z", "status": "ok"}, {"id": 4879, "org_id": 21502, "name": "MAINPORT Peer-Exchange", "aka": "MPXE", "name_long": "", "city": "Frankfurt am Main", "country": "DE", "region_continent": "Europe", "media": "Ethernet", "notes": "MAINPORT is a carrier-neutral connectivity platform based in Frankfurt, Germany. We operate a regional interconnection fabric across Digital Realty FRA11–FRA16 and Equinix FR5, providing access to Internet, IP-Transit, Cloud, and Internet Exchange services through a single physical port.\n\nConnections are available via cross-connect or campus fabric within the listed data centers.\n\nKey features:   \n- Carrier-neutral & redundant backbone within Frankfurt   \n- IP-Transit and IXP connectivity   \n- 10 / 25 / 40 / 100 Gbit/s ports (LR / LR4 / BiDi)   \n- 24 / 7 NOC and automated provisioning", "proto_unicast": true, "proto_multicast": false, "proto_ipv6": true, "website": "https://mainport.one/#peer-exchange", "social_media": [{"service": "website", "identifier": "https://mainport.one/#peer-exchange"}], "url_stats": "", "tech_email": "noc@level66.network", "tech_phone": "+4961327358842", "polic